{"ts":1783115542,"hash":"0048fff92a099a2ff3049ba13d0932c11538235d080b2f242c66a9945ff6d58b","mode":"diff","ops":[{"tag":"replace","a1":10,"a2":11,"text":"// Node representa um nó na árvore binária.\ntype Node struct {\n\tValue int\n\tLeft  *Node\n\tRight *Node\n}\n\nfunc ehNulo()\n\n// create constrói uma árvore binária a partir de uma lista de strings.\n// Consuma os elementos da lista sempre do início.\n// Você pode obter o primeiro elemento com 'elem := (*parts)[0]'\n// Você pode fazer um \"push_front\" no array usando '*parts = (*parts)[1:]\n// Se o elemento for \"#\", significa que o nó é nulo.\nfunc create(parts *[]string) *Node {\n\ttree := &Node{Value: 0, Left: nil, Right: nil}\n\tfor range len(*parts) {\n\t\ttree.Value, _ = strconv.Atoi((*parts)[0])\n\t\ttree.Left, _ = strconv.Atoi((*parts)[0])\n\t\t*parts = (*parts)[1:]\n\n\t}\n\t\n\treturn tree\n}\n\n"}]}
