            "label": "2026-06-03_03-02-29",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"slices\"\n)\n\nfunc scanear(n int) []int {\n\tvetor := make([]int, n)\n\tfor i := range vetor {\n\t\tfmt.Scan(&vetor[i])\n\t}\n\treturn vetor\n}\n\nfunc busca(numeros []int, k, i, sum int) bool {\n\tif sum == k {\n\t\treturn true\n\t}\n\tif i == len(numeros) || sum > k {\n\t\treturn false\n\t}\n\treturn busca(numeros, k, i+1, sum + numeros[i]) || busca(numeros, k, i+1, sum)\n}\n\nfunc main() {\n\tvar n, k int\n\tfmt.Scan(&n, &k)\n\tnumeros := scanear(n)\n\tslices.Sort(numeros)\n\tfmt.Println(busca(numeros, k, 0, 0))\n}\n",
